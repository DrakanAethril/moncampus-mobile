<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: overrides src/main/res/xml/network_security_config.xml (Android merges the
    debug source set over main), so plain HTTP reaches the dev API from a real phone too - through
    the Mac's LAN address, given as the API_BASE_URL dart-define (see README).
    The main file keeps cleartext scoped to the emulator and localhost; release builds never see
    this one.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
