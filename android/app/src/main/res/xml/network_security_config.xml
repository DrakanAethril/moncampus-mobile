<?xml version="1.0" encoding="utf-8"?>
<!--
    Dev-only: allows plain HTTP (no TLS) to the local moncampus API - see lib/services/
    api_config.dart. Android blocks cleartext traffic by default since API 28; scoped narrowly to
    the dev hosts rather than a blanket usesCleartextTraffic="true" for the whole app. Revisit once
    the API is served over HTTPS (production should never need this file at all).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
